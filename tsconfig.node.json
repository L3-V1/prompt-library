{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/.tsc/node",
    "tsBuildInfoFile": "dist/.tsc/node.tsbuildinfo"
  },
  "include": ["src/core", "src/server", "skills", "*.config.ts"]
}
