{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "dist/.tsc/web",
    "tsBuildInfoFile": "dist/.tsc/web.tsbuildinfo"
  },
  "include": ["src/web"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
